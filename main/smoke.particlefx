      x: 0.0
      y: 25.0
      t_x: 1.0
      t_y: 0.0
    }
    spread: 5.0
  }
  properties {
    key: "PROPERTY_TYPE_EMITTER_SIZE_X"
    points {
      x: 0.0
      y: 70.0
      t_x: 1.0
      t_y: 0.0
    }
    spread: 0.0
  }
  properties {
    key: "PROPERTY_TYPE_EMITTER_SIZE_Y"
    points {
      x: 0.0
      y: 15.0
      t_x: 1.0
      t_y: 0.0
    }
    spread: 0.0
  }
  particle_properties {
    key: "PARTICLE_PROPERTY_TYPE_COLOR_R"
    points {
      x: 0.0
      y: 0.9
      t_x: 1.0
      t_y: 0.0
    }
  }
  particle_properties {
    key: "PARTICLE_PROPERTY_TYPE_COLOR_G"
    points {
      x: 0.0
      y: 0.9
      t_x: 1.0
      t_y: 0.0
    }
  }
  particle_properties {
    key: "PARTICLE_PROPERTY_TYPE_COLOR_B"
    points {
      x: 0.0
      y: 0.9
      t_x: 1.0
      t_y: 0.0
    }
  }
  particle_properties {
    key: "PARTICLE_PROPERTY_TYPE_COLOR_A"
    points {
      x: 0.0
